{
    "version": "3.9.7",
    "description": "A full-featured download manager — rebuilt from the ground up.",
    "homepage": "https://motrix-next.pages.dev",
    "license": "MIT",
    "notes": [
        "Scoop 直接解包 NSIS 安装程序，因此不会注册 magnet://、ed2k://、thunder:// 深链接和 .torrent 文件关联；需要这些功能请使用官方安装包。",
        "应用数据目录（%APPDATA%\\com.motrix.next）已链接到 Scoop 持久化目录，升级不会丢失配置、下载历史与任务恢复缓存；卸载（不带 -p）时数据仍保留在持久化目录。",
        "应用内置自动更新会直接替换文件，可能与 Scoop 管理冲突，建议在“设置→常规”中关闭自动更新，统一使用 scoop update motrix-next 更新。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v3.9.7/MotrixNext_3.9.7_x64-setup.exe#/dl.7z",
            "hash": "80b13a8b967481dbfd59d9c81aa8a4db575462e5994f18514727e768bff580b3"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v3.9.7/MotrixNext_3.9.7_arm64-setup.exe#/dl.7z",
            "hash": "dfa61574ce8a87ee4a6130321b9f3700b84a30ede3673051410a3a2088378c32"
        }
    },
    "pre_install": [
        "Remove-Item -Path \"$dir\\`$*\", \"$dir\\uninstall.exe.nsis\" -Force -Recurse -ErrorAction Ignore",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "New-PersistDirectory \"$env:APPDATA\\com.motrix.next\" \"$persist_dir\\AppData\" -Migrate"
    ],
    "bin": "motrix-next.exe",
    "shortcuts": [
        [
            "motrix-next.exe",
            "Motrix Next"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "Get-Process -Name 'motrix-next','motrix-next-engine' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Remove-Junction \"$env:APPDATA\\com.motrix.next\""
    ],
    "checkver": {
        "github": "https://github.com/AnInsomniacy/motrix-next"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v$version/MotrixNext_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v$version/MotrixNext_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
