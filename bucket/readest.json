{
    "version": "0.12.20",
    "description": "An open-source ebook reader designed for immersive and deep reading experiences",
    "homepage": "https://readest.com/",
    "license": "AGPL-3.0-or-later",
    "notes": [
        "You may need to install Edge WebView2 Runtime to use Readest.",
        "A WebView2 Runtime installer is available in '$dir\\redist'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/readest/readest/releases/download/v0.12.20/Readest_0.12.20_x64-setup.exe#/dl.7z",
            "hash": "34714298219311c2e7b233fe98ae98976108779b9a343d6f226b505c6387d643"
        },
        "arm64": {
            "url": "https://github.com/readest/readest/releases/download/v0.12.20/Readest_0.12.20_arm64-setup.exe#/dl.7z",
            "hash": "f9bfec0f1a4031b44de46c46dbd013be280026c806f7cfdadf2c7e659ca1a64e"
        }
    },
    "installer": {
        "script": [
            "Remove-Item \"$dir\\`$PLUGINSDIR\" -Force -Recurse -ErrorAction SilentlyContinue",
            "if (Test-Path \"$dir\\`$TEMP\") { Rename-Item -Path \"$dir\\`$TEMP\" -NewName \"redist\" }",
            ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\com.bilingify.readest\" \"$persist_dir\\Roaming\" -Migrate",
            "New-PersistDirectory \"$env:LOCALAPPDATA\\com.bilingify.readest\" \"$persist_dir\\Local\" -Migrate"
        ]
    },
    "shortcuts": [
        [
            "readest.exe",
            "Readest"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "Remove-Junction \"$env:APPDATA\\com.bilingify.readest\"",
        "Remove-Junction \"$env:LOCALAPPDATA\\com.bilingify.readest\""
    ],
    "checkver": {
        "github": "https://github.com/readest/readest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/readest/readest/releases/download/v$version/Readest_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/readest/readest/releases/download/v$version/Readest_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
