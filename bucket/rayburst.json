{
    "version": "4.0.0",
    "description": "A full-featured download manager with native media downloads, live recording, and browser integration (formerly Motrix Next)",
    "homepage": "https://rayburst.pages.dev",
    "license": "MIT",
    "notes": [
        "Scoop 直接解包 NSIS 安装程序，因此不会注册 magnet://、ed2k://、thunder://、rayburst:// 深链接和 .torrent 文件关联；需要这些功能请使用官方安装包。",
        "应用数据目录（%APPDATA%\\dev.aninsomniacy.rayburst）已链接到 Scoop 持久化目录，升级不会丢失配置、下载历史与任务恢复缓存；卸载（不带 -p）时数据仍保留在持久化目录。",
        "应用内置自动更新会直接替换文件，可能与 Scoop 管理冲突，建议在“设置→常规”中关闭自动更新，统一使用 scoop update rayburst 更新。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.0.0/Rayburst_4.0.0_x64-setup.exe#/dl.7z",
            "hash": "6025330aa6e36b65af9c71930a3a341feeeff621e9364bc6c69046627f787352"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.0.0/Rayburst_4.0.0_arm64-setup.exe#/dl.7z",
            "hash": "c47295dd9609238e1e822475d7e8030ce5a5c8783556eb4bd486da9b15f03c2e"
        }
    },
    "pre_install": [
        "Remove-Item -Path \"$dir\\`$*\", \"$dir\\uninstall.exe*\" -Force -Recurse -ErrorAction Ignore",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "New-PersistDirectory \"$env:APPDATA\\dev.aninsomniacy.rayburst\" \"$persist_dir\\AppData\" -Migrate"
    ],
    "shortcuts": [
        [
            "rayburst.exe",
            "Rayburst"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "Get-Process -Name 'rayburst','aria2-next','rayburst-browser-launcher' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Remove-Junction \"$env:APPDATA\\dev.aninsomniacy.rayburst\""
    ],
    "checkver": {
        "github": "https://github.com/AnInsomniacy/rayburst"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
