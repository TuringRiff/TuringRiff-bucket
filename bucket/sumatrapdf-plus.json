{
    "version": "3.7.11",
    "description": "Unofficial fork of SumatraPDF with improvements for Chinese ebooks, offline lookup, themes, and smart PDF dark mode",
    "homepage": "https://github.com/dengxibo/sumatrapdf-plus",
    "license": "GPL-3.0-only,BSD-2-Clause",
    "notes": [
        "Full package includes fonts and offline dictionary for double-click word lookup.",
        "This is a community fork of SumatraPDF (GPLv3), not an official release from sumatrapdfreader.org."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/dengxibo/sumatrapdf-plus/releases/download/v3.7.11/Sumatra.PDF.Plus.MainProgram+dictionary.zip",
            "hash": "34af3c8a67c4ba1532529c6d57f036512515a00d3d82500d1e35654e67148f6c"
        }
    },
    "pre_install": [
        "$file = 'SumatraPDF-settings.txt'",
        "if (!(Test-Path \"$persist_dir\\$file\")) {",
        "    Write-Host 'File' $file 'does not exists. Creating.' -f Yellow",
        "    Set-Content \"$dir\\$file\" 'CheckForUpdates = false' -Encoding Ascii",
        "}",
        "Get-ChildItem \"$dir\\SumatraPDF-*.exe\" | Rename-Item -NewName 'SumatraPDF.exe'"
    ],
    "bin": "SumatraPDF.exe",
    "shortcuts": [
        [
            "SumatraPDF.exe",
            "Sumatra PDF Plus"
        ]
    ],
    "persist": [
        "SumatraPDF-settings.txt",
        "sumatrapdfcache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dengxibo/sumatrapdf-plus/releases/download/v$version/Sumatra.PDF.Plus.MainProgram+dictionary.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
